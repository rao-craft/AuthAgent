{
  "into": "Components/Auth/Views",
  "mark": "SeerMark()",
  "look": [
    "accent = Color.accent",
    "titleColor = Color.primary.opacity(0.75)",
    "subtitleColor = Color.primary.opacity(0.6)",
    "spinner = Color.white",
    "title = Font.brandTitle",
    "subtitle = Font.brandNote2.italic()",
    "field = Font.system(size: 16, weight: .regular, design: .serif)",
    "link = Font.system(size: 13, weight: .medium, design: .serif)",
    "message = Font.system(size: 13, design: .serif)",
    "button = Font.system(size: 16, weight: .semibold, design: .serif)",
    "footer = Font.system(size: 14, design: .serif)",
    "footerLink = Font.system(size: 14, weight: .semibold, design: .serif)",
    "sheetTitle = Font.brandTitle",
    "instruction = Font.system(size: 16, weight: .regular, design: .serif)",
    "sheetMessage = Font.system(size: 13)"
  ],
  "strings": [
    "email = \"Email\"",
    "signIn.title = \"Welcome to Seer\"",
    "signIn.subtitle = \"Sign in to continue\"",
    "signIn.password = \"Password\"",
    "signIn.forgot = \"Forgot password?\"",
    "signIn.button = \"Sign In\"",
    "signIn.footer = \"Don't have an account?\"",
    "signIn.footerLink = \"Create one.\"",
    "signIn.refused = \"Unauthorized: \"",
    "signIn.invalid = \"Invalid login credentials\"",
    "signUp.title = \"Create account\"",
    "signUp.subtitle = \"Start your journey\"",
    "signUp.password = \"Password (min 6 characters)\"",
    "signUp.confirm = \"Confirm password\"",
    "signUp.mismatch = \"Passwords do not match\"",
    "signUp.button = \"Create Account\"",
    "signUp.footer = \"Already have an account?\"",
    "signUp.footerLink = \"Sign in.\"",
    "code.title = \"Verify your email\"",
    "code.resetTitle = \"Check your email\"",
    "code.sent = \"We sent a 6-digit code to\"",
    "code.placeholder = \"code\"",
    "code.hint = \"Didn't receive it? Check your spam folder.\"",
    "code.button = \"Verify Email\"",
    "code.resetButton = \"Verify & Reset\"",
    "code.back = \"Use a different email\"",
    "forgot.title = \"Reset Password\"",
    "forgot.instruction = \"Enter your email and we'll send you a reset code.\"",
    "forgot.button = \"Send Reset Code\""
  ],
  "tuning": [
    "swap = spring 0.38 0.88",
    "mark.size = 100",
    "mark.turn = 42",
    "mark.shadow = 0.3 3 1 1",
    "code.tracking = 12",
    "code.glyph = envelope.badge",
    "forgot.glyph = lock.rotation",
    "forgot.detents = medium large",
    "password.minimum = 6"
  ],
  "launch": [
    "auth = signIn",
    "auth.signup = signUp",
    "auth.code = code \"ada@seer.social\"",
    "auth.forgot = forgot"
  ]
}
